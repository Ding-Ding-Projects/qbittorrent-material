#include <windows.h>

IDI_QBITTORRENT_MATERIAL ICON "@QBT_BRANDING_ICON_RC_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @QBT_PACKAGE_VERSION_RC_NUMERIC@
 PRODUCTVERSION @QBT_PACKAGE_VERSION_RC_NUMERIC@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "qBittorrent Material contributors\0"
            VALUE "FileDescription", "qBittorrent Material\0"
            VALUE "FileVersion", "@QBT_PACKAGE_VERSION_RC_STRING@\0"
            VALUE "InternalName", "qbittorrent.exe\0"
            VALUE "OriginalFilename", "qbittorrent.exe\0"
            VALUE "ProductName", "qBittorrent Material\0"
            VALUE "ProductVersion", "@QBT_PACKAGE_VERSION_RC_STRING@\0"
            VALUE "SquirrelAwareVersion", "1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
