<!--
  qBittorrent (Material rewrite) — hand-authored resource manifest.
  Copyright (C) 2026  qBittorrent-Material contributors
  SPDX-License-Identifier: GPL-3.0-or-later

  This is the canonical list of bundled binary assets, exposed under stable
  classic ":/..." paths that the C++ providers rely on:
      :/fonts/MaterialSymbolsOutlined.ttf   (MDIcon glyphs)
      :/fonts/Roboto.ttf, :/fonts/RobotoMono.ttf
      :/i18n/cantonese.json                 (FunnyTranslator catalog)
      :/experience/changelog.json           (offline in-app release history)
      :/experience/release-identity.json    (public release code-name metadata)
      :/branding/logo-mark.png              (window and normal tray artwork)
      :/branding/logo-monochrome.png        (monochrome tray artwork)
      :/html/gpl.html                       (About dialog license text)
      :/searchengine/nova3/*.py             (nova3 search runtime, extracted to
                                             <Data>/nova3 by SearchPluginManager)

  NOTE: By default the build does NOT compile this file verbatim — it uses a
  tolerant glob of whatever assets currently exist (see src/CMakeLists.txt), so
  the project builds before optional assets have landed. This manifest itself
  contains only checked-in resources, so -DQBT_BUNDLE_QRC=ON is valid today.
  Country flag SVGs remain optional: when none are bundled, FlagImageProvider
  returns a transparent placeholder for image://flags/<iso> instead of a broken
  image. DesktopIntegration uses the branding SVG above rather than absent tray
  PNG assets.
-->
<RCC>
    <qresource prefix="/">
        <file alias="fonts/MaterialSymbolsOutlined.ttf">fonts/MaterialSymbolsOutlined.ttf</file>
        <file alias="fonts/Roboto.ttf">fonts/Roboto.ttf</file>
        <file alias="fonts/RobotoMono.ttf">fonts/RobotoMono.ttf</file>
        <file alias="i18n/cantonese.json">i18n/cantonese.json</file>
        <file alias="experience/changelog.json">experience/changelog.json</file>
        <file alias="experience/release-identity.json">experience/release-identity.json</file>
        <file alias="branding/logo-mark.png">branding/logo-mark.png</file>
        <file alias="branding/logo-monochrome.png">branding/logo-monochrome.png</file>
        <file alias="html/gpl.html">html/gpl.html</file>
        <file alias="searchengine/unofficial-plugins.json">searchengine/unofficial-plugins.json</file>
        <file alias="searchengine/nova3/helpers.py">searchengine/nova3/helpers.py</file>
        <file alias="searchengine/nova3/nova2.py">searchengine/nova3/nova2.py</file>
        <file alias="searchengine/nova3/nova2dl.py">searchengine/nova3/nova2dl.py</file>
        <file alias="searchengine/nova3/novaprinter.py">searchengine/nova3/novaprinter.py</file>
        <file alias="searchengine/nova3/socks.py">searchengine/nova3/socks.py</file>
        <file alias="searchengine/nova3/engines/eztv.py">searchengine/nova3/engines/eztv.py</file>
        <file alias="searchengine/nova3/engines/jackett.py">searchengine/nova3/engines/jackett.py</file>
        <file alias="searchengine/nova3/engines/limetorrents.py">searchengine/nova3/engines/limetorrents.py</file>
        <file alias="searchengine/nova3/engines/piratebay.py">searchengine/nova3/engines/piratebay.py</file>
        <file alias="searchengine/nova3/engines/solidtorrents.py">searchengine/nova3/engines/solidtorrents.py</file>
        <file alias="searchengine/nova3/engines/torlock.py">searchengine/nova3/engines/torlock.py</file>
        <file alias="searchengine/nova3/engines/torrentproject.py">searchengine/nova3/engines/torrentproject.py</file>
        <file alias="searchengine/nova3/engines/torrentscsv.py">searchengine/nova3/engines/torrentscsv.py</file>
    </qresource>
</RCC>
